{
  "info": {
    "_postman_id": "30dd8ef0-06f8-4bd1-9788-5b00d72d37dc",
    "name": "Laravel Registration API",
    "description": "Коллекция для демонстрации регистрации нового пользователя и получения его профиля.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"candidate{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"gender\": \"male\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api_url}}/registration",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "registration"
          ]
        },
        "description": "Создаёт пользователя. Допустимые значения gender: male, female, other. Пароль должен содержать не менее 8 символов."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.collectionVariables.set('access_token', response.token.access_token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/profile",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "profile"
          ]
        },
        "description": "Возвращает данные пользователя по JWT-токену, сохранённому после запроса Registration."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Profile returned', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().user).to.have.property('gender');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "api_url",
      "value": "https://registration-api-kech.amvera.io/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ]
}
